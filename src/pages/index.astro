---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import DailyNote from '../components/DailyNote.astro';
import Footer from '../components/Footer.astro';
import CommitteePanel from '../components/CommitteePanel.astro';
import MusicPlayer from '../components/MusicPlayer.astro';

const title = 'رغد 🤍';
const description = 'في كم شغلة صغيرة لازم تتذكّريها.';
---

<Base title={title} description={description}>
  <main id="main">
    <Stage />
  </main>

  {/* لا يظهر إلا بعد أن تنتهي الحكاية — أثناءها يكسر الإحساس */}
  <div id="after" hidden>
    <DailyNote />
    <Footer />
  </div>

  <CommitteePanel />
  <MusicPlayer />
</Base>

<script>
  import '../scripts/main';
</script>
