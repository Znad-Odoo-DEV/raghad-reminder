---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import Hero from '../components/Hero.astro';
import GraceCard from '../components/GraceCard.astro';
import SweetDose from '../components/SweetDose.astro';
import Wishes from '../components/Wishes.astro';
import CommitteePanel from '../components/CommitteePanel.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Footer from '../components/Footer.astro';

const title = 'رغد طابت، الحمد لله 🤍';
const description =
  'ألطف وأجمل صدفة بحياتي — وصارت بخير. صفحة صغيرة للفرح، وعدّاد من يوم الصدفة، وجملة حلوة كل يوم.';
---

<Base title={title} description={description}>
  <Ticker />

  <main id="main">
    <Hero />
    <GraceCard />
    <SweetDose />
    <Wishes />
  </main>

  <Footer />
  <CommitteePanel />
  <MusicPlayer />
</Base>

<script>
  import '../scripts/main';
</script>
