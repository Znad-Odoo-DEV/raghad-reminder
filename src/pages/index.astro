---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import DailyNote from '../components/DailyNote.astro';
import Footer from '../components/Footer.astro';
import CommitteePanel from '../components/CommitteePanel.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { DAILY_NOTIFY } from '../site.config';

const title = 'وزارة الاتصالات — الوزيرة رغد 🤍';
const description = 'بوّابة رسمية. اللطافة إجبارية.';
---

<Base title={title} description={description}>
  <main id="main">
    <Stage />
  </main>

  {/* التذييل على البوّابة وحدها؛ ورسالة اليوم خلف مفتاحها المؤقّت */}
  <div id="after" hidden>
    {DAILY_NOTIFY && <DailyNote />}
    <Footer />
  </div>

  <CommitteePanel />
  <MusicPlayer />
</Base>

<script>
  import '../scripts/main';
</script>
