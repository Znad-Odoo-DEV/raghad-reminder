---
/**
 * EnvelopeGlyph — الظرف
 *
 * أجزاؤه منفصلة عمداً — الغطاء والورقة والجيب والختم — حتى ينفتح فعلاً بدل أن
 * يتبدّل بصورة أخرى. ترتيب الرسم يصنع الوهم: الورقة فوق الظهر وتحت الجيب،
 * فتبدو خارجةً من داخله لا طافيةً عليه.
 *
 * الفتح يقلب الغطاء حول حافته العليا بـ`scaleY(-1)`. لا حاجة إلى تحويل ثلاثي
 * الأبعاد، والنتيجة نفسها على كل المتصفحات.
 */
interface Props {
  /** معرّف فريد للتدرّجات — لتفادي تضارب الـIDs عند تكرار الرمز */
  id?: string;
  /** الظرف الأخير يُرسم أفخم قليلاً */
  variant?: 'plain' | 'final';
  class?: string;
}

const { id = 'env', variant = 'plain', class: className } = Astro.props;
---

<svg
  class:list={['env', `env--${variant}`, className]}
  viewBox="0 0 120 92"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-body`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#c4b5fd" />
      <stop offset="100%" stop-color="#8b6bff" />
    </linearGradient>
    <linearGradient id={`${id}-flap`} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0%" stop-color="#d6cbff" />
      <stop offset="100%" stop-color="#a78bfa" />
    </linearGradient>
    <linearGradient id={`${id}-pocket`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0%" stop-color="#b6a2fd" />
      <stop offset="100%" stop-color="#7c5cf0" />
    </linearGradient>
  </defs>

  <!-- ظهر الظرف -->
  <rect x="6" y="20" width="108" height="64" rx="7" fill={`url(#${id}-body)`} />

  <!-- الورقة: تخرج للأعلى عند الفتح -->
  <g class="env__paper">
    <rect x="19" y="10" width="82" height="60" rx="4" fill="#fffdfa" />
    <rect x="29" y="24" width="62" height="3" rx="1.5" fill="#cfc6ea" />
    <rect x="29" y="34" width="48" height="3" rx="1.5" fill="#dcd5f0" />
    <rect x="29" y="44" width="55" height="3" rx="1.5" fill="#dcd5f0" />
  </g>

  <!-- الجيب: يغطّي أسفل الورقة فتبدو داخله -->
  <path
    d="M6 46 L60 76 L114 46 L114 77 Q114 84 107 84 L13 84 Q6 84 6 77 Z"
    fill={`url(#${id}-pocket)`}
  />

  <!-- الغطاء -->
  <path
    class="env__flap"
    d="M6 27 Q6 20 13 20 L107 20 Q114 20 114 27 L60 57 Z"
    fill={`url(#${id}-flap)`}
  />

  <!-- الختم -->
  <g class="env__seal">
    <circle cx="60" cy="50" r="10.5" fill="#6d4aca" />
    <circle cx="60" cy="50" r="10.5" fill="none" stroke="#fffdfa" stroke-width="1.2" stroke-dasharray="2 3" opacity=".7" />
    <path d="M60 55.5c0 0-5.6-3.3-5.6-6.5a2.9 2.9 0 0 1 5.6-1 2.9 2.9 0 0 1 5.6 1c0 3.2-5.6 6.5-5.6 6.5Z" fill="#fffdfa" />
  </g>
</svg>

<style>
  .env {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .env__flap {
    transform-origin: 60px 23px;
    transition: transform .72s var(--e-back);
  }

  .env__paper {
    transform: translateY(26px);
    opacity: 0;
    transition: transform .78s var(--e-out) .12s, opacity .3s linear .12s;
  }

  .env__seal {
    transform-origin: 60px 50px;
    transition: transform .34s var(--e-soft), opacity .28s linear;
  }

  /* الختم ينكسر أولاً، ثم يُقلب الغطاء، ثم تطلع الورقة */
  :global(.is-open) .env__seal {
    transform: scale(.4) rotate(-14deg);
    opacity: 0;
  }
  :global(.is-open) .env__flap { transform: scaleY(-1); }
  :global(.is-open) .env__paper {
    transform: translateY(-14px);
    opacity: 1;
  }

  /* الظرف الأخير: هالة تحته */
  .env--final { filter: drop-shadow(0 14px 34px rgba(109, 74, 202, .34)); }

  @media (prefers-reduced-motion: reduce) {
    .env__flap, .env__paper, .env__seal { transition: none; }
  }
</style>
