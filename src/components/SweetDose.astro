---
import { FROM } from '../site.config';
import { sweetLabelAr } from '../scripts/schedule';

const WA = 'https://wa.me/971525691003?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%20%D8%A5%D8%A8%D8%B1%D8%A7%D9%87%D9%8A%D9%85%20%F0%9F%A4%8D';
const IG = 'https://www.instagram.com/znad_0';
const icsHref = `${import.meta.env.BASE_URL}raghd-sweet.ics`;
const at = sweetLabelAr();
---

<section class="sweet section" id="sweet" aria-labelledby="sweet-heading">
  <div class="wrap">
    <div class="sweet__head reveal">
      <p class="eyebrow">جرعة اللطافة اليومية</p>
      <h2 id="sweet-heading" class="sweet__title">
        منرنّ عليكِ. <span class="gradient-text">كل يوم.</span> بجملة حلوة.
      </h2>
      <p class="sweet__lead">
        رسالة وحدة، الساعة {at} بتوقيت سوريا. مو إلحاح ولا مواعيد — بس تذكير
        إنك بخير، وإنك super special 🤍
      </p>
    </div>

    <div class="sweet__grid">
      <!-- ============ الخيار الأول: التقويم ============ -->
      <article class="opt opt--primary reveal">
        <div class="opt__top">
          <span class="opt__icon" aria-hidden="true">📅</span>
          <span class="opt__badge">الخيار الأضمن</span>
        </div>

        <h3 class="opt__title">ضيفيها على تقويم الموبايل</h3>
        <p class="opt__body">
          هون <b>الموبايل نفسه</b> يلي يذكّرك، مو المتصفح. يعني بتوصلك وأنتِ
          بالإنستغرام، أو والشاشة مطفية، أو والنت مقطوع.
          <br />جملة وحدة كل يوم الساعة <b>{at}</b>. ولا شي غيرها.
          <br /><b>بتضيفيها مرة وحدة وبتنسيها</b> — وهي ما تنساك.
        </p>

        <a class="btn btn--primary" href={icsHref} download="raghd-sweet.ics" data-ics>
          حمّليها 🤍
        </a>

        <p class="opt__hint">
          <b>آيفون:</b> افتحي الملف ← «إضافة إلى التقويم». خلصت.<br />
          <b>أندرويد:</b> افتحيه بتقويم Google. كمان خلصت.
        </p>
      </article>

      <!-- ============ الخيار الثاني: تنبيه المتصفح ============ -->
      <article class="opt reveal" style="--reveal-delay: 110ms">
        <div class="opt__top">
          <span class="opt__icon" aria-hidden="true">🔔</span>
          <span class="opt__badge opt__badge--soft" data-notif-badge>اختياري</span>
        </div>

        <h3 class="opt__title">تنبيه من المتصفح</h3>
        <p class="opt__body">
          نفس الجملة بالضبط، بس هاد <b>دلّوع</b>: بيشتغل إذا الصفحة مفتوحة ولو
          بالخلفية. سكّرتي المتصفح؟ بينام معه 😴
          <br />عشان هيك التقويم هو الأساس، وهاد بس مساعد.
        </p>

        <button class="btn btn--ghost" type="button" data-notif-enable>
          فعّليه، ما بيعضّ 🔔
        </button>

        <p class="opt__hint" data-notif-status role="status">
          لسا ما فعّلتيه. ولا مشكلة أبداً.
        </p>
      </article>
    </div>

    <!-- ============ إضافة للشاشة الرئيسية ============ -->
    <p class="sweet__foot reveal" style="--reveal-delay: 200ms">
      <span aria-hidden="true">📲</span>
      وإذا بدك تكرّمينا: ضيفي الموقع للشاشة الرئيسية من قائمة المتصفح. بيصير
      له أيقونة وبيفتح متل تطبيق حقيقي — تطبيق وظيفته الوحيدة بالحياة إنه
      يقول «الحمد لله إنك بخير». طموح، صح؟
    </p>

    <!-- ============ التواصل ============ -->
    <aside class="reach reveal" style="--reveal-delay: 260ms" aria-labelledby="reach-heading">
      <div class="reach__text">
        <h3 id="reach-heading" class="reach__title">
          <span aria-hidden="true">🤍</span> بالذمة، شو رح يصير؟
        </h3>
        <p class="reach__body">
          <b>إشعار واحد باليوم</b>، الساعة <b>{at}</b>، وبكلمتين حلوين. ما في
          إلحاح، ما في تكرار، ولا في موعد لازم تلحقيه — خلص، الحمد لله.
        </p>
        <p class="reach__body">
          تعبتي منّا؟ بدك تلغي الإشعارات أو تغيّري الموعد؟ أو بس بدك تحكي؟
          كل شي بيروح لـ<b>{FROM}</b> 👇
        </p>
      </div>

      <div class="reach__actions">
        <a
          class="chan chan--wa"
          href={WA}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="chan__ico" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.96L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15h-.01c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Z"/>
          </svg>
          واتساب
        </a>

        <a
          class="chan chan--ig"
          href={IG}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="chan__ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9">
            <rect x="3" y="3" width="18" height="18" rx="5.2"/>
            <circle cx="12" cy="12" r="3.8"/>
            <circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"/>
          </svg>
          إنستغرام
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .sweet__head {
    max-width: 46ch;
    margin-inline: auto;
    text-align: center;
    margin-block-end: clamp(1.75rem, 1.1rem + 2.2vw, 3rem);
  }

  .sweet__title {
    font-size: var(--t-h2);
    letter-spacing: -.03em;
    margin-block: var(--s-3) var(--s-3);
  }

  .sweet__lead { color: var(--c-ink-soft); }

  .sweet__grid {
    display: grid;
    gap: clamp(.8rem, .6rem + 1vw, 1.25rem);
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 820px) {
    .sweet__grid { grid-template-columns: 1fr 1fr; }
  }

  /* ---- البطاقة ---- */
  .opt {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: clamp(1.35rem, 1rem + 1.6vw, 2rem);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, .76);
    border: 1px solid rgba(23, 18, 56, .07);
    box-shadow: var(--sh-sm);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: transform var(--d-base) var(--e-out), box-shadow var(--d-base) var(--e-soft);
  }
  .opt:hover { transform: translateY(-3px); box-shadow: var(--sh-md); }

  .opt--primary {
    border-color: color-mix(in srgb, var(--c-pink) 30%, transparent);
    box-shadow: var(--sh-md), 0 0 0 4px rgba(255, 111, 181, .09);
  }

  .opt__top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .opt__icon {
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    border-radius: var(--r-sm);
    background: var(--c-pink-wash);
    font-size: 1.3rem;
    line-height: 1;
  }

  .opt__badge {
    margin-inline-start: auto;
    padding: .28rem .7rem;
    border-radius: var(--r-pill);
    background: var(--c-pink);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 700;
  }
  .opt__badge--soft {
    background: rgba(23, 18, 56, .06);
    color: var(--c-ink-faint);
  }
  .opt__badge--on {
    background: var(--c-mint-wash);
    color: var(--c-mint-deep);
  }
  .opt__badge--off {
    background: var(--c-alert-wash);
    color: var(--c-alert-deep);
  }

  .opt__title {
    font-size: clamp(1.08rem, .95rem + .6vw, 1.3rem);
    font-weight: 700;
    letter-spacing: -.02em;
  }

  .opt__body {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    line-height: 1.75;
    flex: 1;
  }
  .opt__body b { color: var(--c-ink); font-weight: 700; }

  .opt .btn {
    width: 100%;
    text-decoration: none;
    margin-block-start: var(--s-2);
  }

  .opt__hint {
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
    line-height: 1.85;
  }
  .opt__hint b { color: var(--c-ink-soft); }

  /* ---- التواصل ---- */
  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1rem, .7rem + 1.2vw, 1.75rem);
    max-width: 760px;
    margin: var(--s-4) auto 0;
    padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgba(255, 111, 181, .09), rgba(109, 74, 255, .07));
    border: 1px solid rgba(255, 111, 181, .2);
  }

  .reach__text { flex: 1 1 300px; }

  .reach__title {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -.015em;
    margin-block-end: .45rem;
  }

  .reach__body {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    line-height: 1.8;
  }
  .reach__body + .reach__body { margin-block-start: .5rem; }
  .reach__body b { color: var(--c-ink); font-weight: 700; }

  .reach__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    flex: 0 1 auto;
  }

  .chan {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 46px;
    padding: .65rem 1.15rem;
    border-radius: var(--r-pill);
    font-size: var(--t-sm);
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--d-fast) var(--e-back), box-shadow var(--d-base) var(--e-soft);
  }
  .chan:hover { transform: translateY(-2px); }
  .chan:active { transform: translateY(0) scale(.97); }

  .chan__ico { width: 18px; height: 18px; flex-shrink: 0; }

  .chan--wa {
    background: linear-gradient(135deg, #25d366, #128c7e);
    box-shadow: 0 8px 20px -9px rgba(18, 140, 126, .9);
  }
  .chan--ig {
    background: linear-gradient(135deg, #833ab4, #e1306c 55%, #f77737);
    box-shadow: 0 8px 20px -9px rgba(225, 48, 108, .9);
  }

  @media (max-width: 560px) {
    .reach__actions { width: 100%; }
    .chan { flex: 1; }
  }

  .sweet__foot {
    max-width: 56ch;
    margin: var(--s-6) auto 0;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, .55);
    border: 1px dashed rgba(23, 18, 56, .13);
    text-align: center;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }
</style>
