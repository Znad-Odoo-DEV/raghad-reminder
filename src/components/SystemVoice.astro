---
const transcript = [
  { who: 'sys', text: 'رغد؟' },
  { who: 'her', text: 'نعم' },
  { who: 'sys', text: 'الدوا.' },
  { who: 'her', text: 'لسا شوي' },
  { who: 'sys', text: 'أنا ما عندي مشكلة شخصية معك، بس الدوا عم يستنى.' },
  { who: 'her', text: 'خمس دقايق وبس' },
  { who: 'sys', text: 'مرّ 17 دقيقة.' },
  { who: 'sys', text: 'أنا فقط أذكّرك… للمرة السابعة 😭' },
];

const rules = [
  {
    n: '01',
    title: 'الدوا ما بينتظر مزاج',
    body: 'موعده 11:00. مو "بعد ما أخلّص الفيديو"، ولا "لما أقوم".',
  },
  {
    n: '02',
    title: 'كلمة "شوي" غير معتمدة',
    body: 'لأسباب علمية بحتة، تبيّن أن "شوي" عند رغد تساوي بين 20 دقيقة وثلاث ساعات.',
  },
  {
    n: '03',
    title: 'التجاهل لا يُلغي الحبة',
    body: 'الدوا ما رح يختفي إذا تجاهلتيه 😂 جرّبنا. ما زبطت.',
  },
];
---

<section class="voice section" aria-labelledby="voice-heading">
  <div class="wrap">
    <div class="voice__head reveal">
      <p class="eyebrow">محضر رسمي — لا يُنشر</p>
      <h2 id="voice-heading" class="voice__title">
        حوار حقيقي بين <span class="gradient-text">النظام ورغد</span>
      </h2>
      <p class="voice__lead">
        أُعيدت كتابته من الذاكرة. الأسماء لم تُغيّر لأن ما في داعي.
      </p>
    </div>

    <div class="voice__grid">
      <!-- ---- المحادثة ---- -->
      <div class="chat reveal" style="--reveal-delay: 90ms">
        <div class="chat__bar" aria-hidden="true">
          <span class="chat__dot"></span>
          <span class="chat__dot"></span>
          <span class="chat__dot"></span>
          <span class="chat__name">سجلّ 11:00 صباحاً</span>
        </div>

        <ol class="chat__log">
          {transcript.map((m, i) => (
            <li
              class:list={['bubble', m.who === 'sys' ? 'bubble--sys' : 'bubble--her']}
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="bubble__who">{m.who === 'sys' ? 'النظام' : 'رغد'}</span>
              <p class="bubble__text">{m.text}</p>
            </li>
          ))}
        </ol>

        <p class="chat__foot">…الحوار مستمر يومياً. بنفس الترتيب تقريباً.</p>
      </div>

      <!-- ---- البنود ---- -->
      <ul class="rules">
        {rules.map((r, i) => (
          <li class="rule reveal" style={`--reveal-delay: ${140 + i * 90}ms`}>
            <span class="rule__n tnum">{r.n}</span>
            <h3 class="rule__title">{r.title}</h3>
            <p class="rule__body">{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .voice__head {
    max-width: 46ch;
    margin-inline: auto;
    text-align: center;
    margin-block-end: clamp(2rem, 1.2rem + 2.5vw, 3.25rem);
  }

  .voice__title {
    font-size: var(--t-h2);
    letter-spacing: -.03em;
    margin-block: var(--s-3) var(--s-3);
  }
  .voice__lead { color: var(--c-ink-soft); }

  .voice__grid {
    display: grid;
    gap: clamp(1rem, .6rem + 1.6vw, 1.75rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 900px) {
    .voice__grid { grid-template-columns: 1.15fr .85fr; }
  }

  /* ---- المحادثة ---- */
  .chat {
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, .8);
    border: 1px solid rgba(255, 255, 255, .9);
    box-shadow: var(--sh-md);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    overflow: hidden;
  }

  .chat__bar {
    display: flex;
    align-items: center;
    gap: .4rem;
    padding: .75rem 1.1rem;
    background: rgba(23, 18, 56, .04);
    border-block-end: 1px solid rgba(23, 18, 56, .06);
  }
  .chat__dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: rgba(23, 18, 56, .16);
  }
  .chat__dot:first-child { background: var(--c-alert); opacity: .6; }
  .chat__name {
    margin-inline-start: auto;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--c-ink-faint);
  }

  .chat__log {
    display: flex;
    flex-direction: column;
    gap: .55rem;
    padding: clamp(1rem, .7rem + 1.2vw, 1.5rem);
    margin: 0;
    list-style: none;
  }

  .bubble {
    max-width: min(84%, 46ch);
    padding: .7rem 1.05rem;
    border-radius: var(--r-md);
    font-size: var(--t-sm);
    line-height: 1.65;
  }

  .bubble__who {
    display: block;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    opacity: .6;
    margin-block-end: .1rem;
  }

  .bubble--sys {
    align-self: flex-start;
    background: var(--c-violet-wash);
    color: var(--c-ink);
    border-start-start-radius: var(--r-xs);
  }

  .bubble--her {
    align-self: flex-end;
    background: linear-gradient(135deg, var(--c-violet) 0%, var(--c-violet-deep) 100%);
    color: #fff;
    border-start-end-radius: var(--r-xs);
    box-shadow: 0 6px 16px -8px rgba(75, 47, 214, .7);
  }
  .bubble--her .bubble__who { opacity: .75; }

  .chat__foot {
    padding: 0 clamp(1rem, .7rem + 1.2vw, 1.5rem) clamp(1rem, .7rem + 1.2vw, 1.5rem);
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }

  /* ---- البنود ---- */
  .rules {
    display: grid;
    gap: .8rem;
  }

  .rule {
    position: relative;
    padding: clamp(1.1rem, .8rem + 1vw, 1.5rem);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, .72);
    border: 1px solid rgba(23, 18, 56, .07);
    box-shadow: var(--sh-sm);
    transition: transform var(--d-base) var(--e-out), box-shadow var(--d-base) var(--e-soft);
  }
  .rule:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-md);
  }

  .rule__n {
    display: block;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--c-pink);
    letter-spacing: .1em;
    margin-block-end: .35rem;
  }

  .rule__title {
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -.015em;
    margin-block-end: .3rem;
  }

  .rule__body {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    line-height: 1.7;
  }
</style>
