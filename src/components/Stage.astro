---
import {
  OPEN, FILE, CLUES, JOKE, BUTTON, LOADING, NAME_SCENE, CD, CANDLE, REVEAL,
} from '../scripts/copy';
import { COINCIDENCE_AT, FIRST_TALK_AT, wallOf } from '../scripts/schedule';
import Candle from './Candle.astro';

/**
 * Stage — كل مشاهد التجربة في مكان واحد.
 *
 * كلها موجودة في الـHTML و`main.ts` تُظهر واحداً فقط. هذا يجعل الانتقال
 * تلاشياً بين طبقتين لا إعادة بناء للـDOM، فيبقى ناعماً على الهاتف —
 * وأنيميشن الدخول تعمل من جديد تلقائياً لأن العنصر يخرج من `display:none`.
 *
 * لا سكربت هنا. المكوّن يشحن العلامات والأنماط، والسلوك كلّه في `main.ts`
 * عبر `data-*`.
 */

const pad2 = (n: number) => String(n).padStart(2, '0');

/** تاريخ الملفّ السرّي — من الإعدادات لا مكتوباً هنا. */
function stamp(at: number | null): string {
  if (at === null) return '—';
  const w = wallOf(at);
  return `${pad2(w.day)}.${pad2(w.month)}.${w.year}`;
}

const fileRows = FILE.rows.map((r) => ({
  k: r.k,
  v:
    r.of === 'coincidence' ? stamp(COINCIDENCE_AT)
    : r.of === 'firstTalk' ? stamp(FIRST_TALK_AT)
    : (r.v ?? '—'),
}));
---

<div class="stage">
  <span class="thread" aria-hidden="true"><i class="thread__fill" data-thread></i></span>

  <!-- ═══════════════ 1 · العتبة ═══════════════ -->
  <section class="scene scene--hush" data-scene="open" hidden>
    <span class="pulse" aria-hidden="true"></span>
    <p class="kicker scene__in" style="--d: 900ms">{OPEN.kicker}</p>
    <p class="huge scene__in" style="--d: 1500ms">{OPEN.line}</p>
    <button class="btn btn--ghost scene__in" style="--d: 2600ms" type="button" data-next>
      {OPEN.cta}
    </button>
  </section>

  <!-- ═══════════════ 2 · الملفّ ═══════════════ -->
  <section class="scene" data-scene="file" hidden>
    <div class="dossier scene__in" style="--d: 100ms">
      <span class="dossier__scan" aria-hidden="true"></span>
      <p class="dossier__title">{FILE.title}</p>
      <dl class="dossier__rows">
        {fileRows.map((r, i) => (
          <div class="dossier__row scene__in" style={`--d: ${420 + i * 260}ms`}>
            <dt>{r.k}</dt>
            <dd class="tnum">{r.v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <p class="scene__lead scene__in" style={`--d: ${420 + fileRows.length * 260 + 420}ms`}>
      {FILE.line}
    </p>
    <button
      class="btn btn--ghost scene__in"
      style={`--d: ${420 + fileRows.length * 260 + 900}ms`}
      type="button"
      data-next
    >{FILE.cta}</button>
  </section>

  <!-- ═══════════════ 3 · الطرَف ═══════════════ -->
  <!-- الكلمات تُحقن واحدةً واحدة: وجودها كلّها في الـDOM يجعلها قائمة -->
  <section class="scene scene--hush" data-scene="clues" hidden>
    <p class="clue" data-clue aria-live="polite"></p>
    <p class="scene__lead clues__tail" data-clues-tail hidden>{CLUES.line}</p>
    <button class="btn btn--ghost" type="button" data-next data-clues-next hidden>
      {CLUES.cta}
    </button>
  </section>

  <!-- ═══════════════ 4 · النهاية المزيّفة ═══════════════ -->
  <section class="scene scene--hush" data-scene="joke" hidden>
    <p class="huge" data-joke-end>{JOKE.end}</p>
    <p class="huge huge--twist" data-joke-twist hidden>{JOKE.twist}</p>
    <button class="btn btn--ghost" type="button" data-next data-joke-next hidden>
      {JOKE.cta}
    </button>
  </section>

  <!-- ═══════════════ 5 · الزرّ ═══════════════ -->
  <section class="scene scene--hush" data-scene="button" hidden>
    <p class="scene__lead scene__in" style="--d: 200ms">{BUTTON.line}</p>
    <p class="kicker scene__in" style="--d: 700ms">{BUTTON.warn}</p>

    <button class="tempt scene__in" style="--d: 1200ms" type="button" data-tempt>
      {BUTTON.label}
    </button>

    <p class="huge huge--twist" data-tempt-after hidden>{BUTTON.after}</p>
    <button class="btn btn--ghost" type="button" data-next data-tempt-next hidden>
      {BUTTON.cta}
    </button>
  </section>

  <!-- ═══════════════ 6 · التحضير ═══════════════ -->
  <section class="scene" data-scene="loading" hidden>
    <p class="load__step" data-load-step aria-live="polite">&nbsp;</p>
    <div class="load__track" aria-hidden="true"><span data-load-fill></span></div>
    <p class="load__pct tnum" data-load-pct aria-hidden="true">0%</p>

    <p class="huge load__done" data-load-done hidden>{LOADING.done}</p>
    <button class="btn btn--primary" type="button" data-next data-load-next hidden>
      {LOADING.cta}
    </button>
  </section>

  <!-- ═══════════════ 7 · الاسم ═══════════════ -->
  <!-- الاسم يُرسم على الكانفاس لا هنا: النصّ يظهر جاهزاً، والغبار يتشكّل -->
  <section class="scene scene--hush" data-scene="name" hidden>
    <p class="scene__lead name__tail" data-name-tail hidden>{NAME_SCENE.line}</p>
    <button class="btn btn--ghost" type="button" data-next data-name-next hidden>
      {NAME_SCENE.cta}
    </button>
  </section>

  <!-- ═══════════════ 8 · العدّ ═══════════════ -->
  <section class="scene scene--cd" data-scene="countdown" hidden>
    <!-- آخر دقيقة: الشاشة رقم واحد ولا شيء غيره -->
    <div class="last" data-cd-last hidden>
      <p class="last__say" data-cd-say>&nbsp;</p>
      <p class="last__n tnum" data-cd-tick>60</p>
    </div>

    <div class="cd" data-cd-body>
      <p class="kicker" data-cd-label>{CD.far}</p>
      <p class="cd__big" data-cd-big><b class="tnum" data-cd-n>—</b><span data-cd-u></span></p>
      <p class="huge" data-cd-one hidden></p>
      <div class="cd__track" aria-hidden="true"><span data-cd-fill></span></div>
      <p class="cd__clock tnum" data-cd-clock>00:00:00</p>
      <p class="scene__hint">{CD.hint}</p>
    </div>
  </section>

  <!-- ═══════════════ 9 · الشمعة ═══════════════ -->
  <section class="scene scene--hush" data-scene="candle" hidden>
    <p class="scene__lead scene__in" style="--d: 200ms">{CANDLE.line}</p>
    <p class="kicker scene__in" style="--d: 800ms">{CANDLE.hint}</p>

    <div class="scene__in" style="--d: 500ms"><Candle /></div>

    <button class="btn btn--primary scene__in" style="--d: 1600ms" type="button" data-blow>
      {CANDLE.cta}
    </button>
    <p class="huge" data-candle-out hidden>{CANDLE.out}</p>
  </section>

  <!-- ═══════════════ 10 · الكشف ═══════════════ -->
  <section class="scene scene--reveal" data-scene="reveal" hidden>
    <p class="reveal__name" data-rev-name hidden>{REVEAL.name}</p>

    <div class="reveal__body" data-rev-body hidden>
      <h1 class="reveal__greet">{REVEAL.greeting}</h1>
      <div class="reveal__lines">
        {REVEAL.lines.map((l, i) => (
          <p class="reveal__l" style={`--d: ${700 + i * 480}ms`}>{l}</p>
        ))}
      </div>
      <p class="scene__hint" style={`--d: ${700 + REVEAL.lines.length * 480 + 300}ms`}>
        {REVEAL.foot}
      </p>
      <button
        class="btn btn--ghost btn--quiet"
        style={`--d: ${700 + REVEAL.lines.length * 480 + 700}ms`}
        type="button"
        data-replay
      >{REVEAL.replay}</button>
    </div>
  </section>
</div>

<style>
  /* ==================== المسرح ==================== */
  .stage {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(4rem, 3rem + 6vw, 7rem) var(--pad-x) clamp(5rem, 4rem + 5vw, 7rem);
  }

  /* خيط التقدّم */
  .thread {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    height: 2px;
    background: rgb(196 181 253 / .1);
    z-index: 60;
  }
  .thread__fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(to left, var(--c-lav-soft), var(--c-rose));
    box-shadow: var(--glow-sm);
    transition: width 1s var(--e-out);
  }

  /* ==================== المشهد ==================== */
  .scene {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    max-width: 34rem;
    text-align: center;
  }
  .scene[hidden] { display: none; }

  /* المشاهد الهادئة تتنفّس أوسع: الفراغ حولها جزءٌ منها */
  .scene--hush { gap: var(--s-5); }

  /* دخول موحّد لكل عنصر: تلاشٍ مع صعود صغير وضبابة تنجلي */
  .scene__in {
    animation: rise .9s var(--e-out) backwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); filter: blur(6px); }
    to   { opacity: 1; transform: none; filter: none; }
  }

  /* ==================== نصوص مشتركة ==================== */
  /*
   * التباعد الحرفي على العربية ليس زينة بل ضرر: الخطّ متّصل، وتوسيع ما بين
   * الحروف يباعد وصلاتها فتبدو الكلمة مفكوكة. القيم الواسعة هنا كانت مأخوذة
   * من عرف لاتيني لا يصحّ على هذا الخطّ.
   */
  .kicker {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--c-ink-faint);
  }

  .huge {
    font-size: var(--t-h1);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.02em;
    color: var(--c-ink);
    text-wrap: balance;
    animation: rise .9s var(--e-out) backwards;
    animation-delay: var(--d, 0ms);
  }
  .huge[hidden] { display: none; }
  .huge--twist { color: transparent; background: var(--g-text); -webkit-background-clip: text; background-clip: text; }

  .scene__lead {
    font-size: var(--t-lead);
    line-height: 1.7;
    color: var(--c-ink-soft);
    text-wrap: balance;
  }
  .scene__hint {
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }

  /* ==================== 1 · نبضة العتبة ==================== */
  .pulse {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--c-ink);
    box-shadow: 0 0 30px 8px rgb(196 181 253 / .55);
    animation: breathe 3.4s var(--e-soft) infinite;
  }
  @keyframes breathe {
    0%, 100% { opacity: .35; transform: scale(.7); }
    50%      { opacity: 1;   transform: scale(1.15); }
  }

  /* ==================== 2 · الملفّ ==================== */
  .dossier {
    position: relative;
    overflow: hidden;
    inline-size: min(100%, 25rem);
    padding: var(--s-5) var(--s-5) var(--s-4);
    border: 1px solid rgb(196 181 253 / .22);
    border-radius: var(--r-md);
    background: rgb(23 16 60 / .5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-align: start;
  }

  /* مسحة ضوء تمرّ مرّة كل بضع ثوانٍ — الملفّ «قيد القراءة» لا صورة ساكنة */
  .dossier__scan {
    position: absolute;
    inset-block: 0;
    inset-inline-start: -40%;
    width: 40%;
    background: linear-gradient(90deg, transparent, rgb(196 181 253 / .12), transparent);
    animation: scan 5.5s var(--e-soft) infinite;
  }
  @keyframes scan {
    0%, 55% { transform: translateX(0); }
    100%    { transform: translateX(350%); }
  }

  .dossier__title {
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--c-lav-soft);
    padding-block-end: var(--s-3);
    margin-block-end: var(--s-3);
    border-block-end: 1px solid rgb(196 181 253 / .16);
  }

  .dossier__rows { display: grid; gap: .55rem; }
  .dossier__row {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--t-sm);
  }
  /* الوصلة المنقّطة تربط الاسم بقيمته عبر الفراغ — هي ما يجعل الصفّ سجلّاً
     لا سطرين متجاورين */
  /*
   * الوصلة عنصرٌ مرن لا عنصرٌ مطلق.
   *
   * المطلق يبدأ من `inset-inline-start`، وهي في RTL الحافّةُ اليمنى، فيمشي
   * الخطّ عكس اتجاه الكلمة ويمرّ فوقها. أمّا `flex: 1` فيملأ ما تبقّى من
   * الفراغ أياً كان اتجاه الكتابة، ولا يعرف يميناً من يسار أصلاً.
   */
  .dossier__row dt {
    color: var(--c-ink-faint);
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: .6em;
    overflow: hidden;
  }
  .dossier__row dt::after {
    content: '';
    flex: 1;
    border-block-end: 1px dotted rgb(196 181 253 / .22);
    transform: translateY(-.28em);
  }
  .dossier__row dd { color: var(--c-ink); font-weight: 700; }

  /* ==================== 3 · الطرَف ==================== */
  .clue {
    min-block-size: 1.3em;
    font-size: var(--t-display);
    font-weight: 700;
    letter-spacing: -.03em;
    color: transparent;
    background: var(--g-text);
    -webkit-background-clip: text;
    background-clip: text;
  }
  /* الكلمة تدخل من الضبابة وتخرج إليها: الظهور الحادّ يُقرأ نصّاً، والذوبان
     يُقرأ لمحة */
  .clue.in { animation: clue-in 2s var(--e-soft) forwards; }
  @keyframes clue-in {
    0%   { opacity: 0; filter: blur(18px); transform: scale(1.14); }
    28%  { opacity: 1; filter: blur(0);    transform: scale(1); }
    72%  { opacity: 1; filter: blur(0);    transform: scale(1); }
    100% { opacity: 0; filter: blur(14px); transform: scale(.94); }
  }
  .clues__tail[hidden], [data-clues-next][hidden] { display: none; }
  .clues__tail { animation: rise .8s var(--e-out) backwards; }

  /* ==================== 5 · الزرّ ==================== */
  /* صغير عمداً: الزرّ الممنوع الذي يملأ الشاشة ليس ممنوعاً بل دعوة */
  .tempt {
    padding: .5rem 1rem;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--c-ink-faint);
    border: 1px dashed rgb(196 181 253 / .35);
    border-radius: var(--r-pill);
    background: transparent;
    transition: transform var(--d-base) var(--e-back), color var(--d-base) var(--e-soft),
                border-color var(--d-base) var(--e-soft), opacity var(--d-base) var(--e-soft);
  }
  .tempt:hover { color: var(--c-ink); border-color: var(--c-lav-soft); transform: scale(1.04); }
  .tempt.gone { opacity: 0; transform: scale(.5) rotate(-8deg); pointer-events: none; }
  [data-tempt-after][hidden], [data-tempt-next][hidden] { display: none; }

  /* ==================== 6 · التحضير ==================== */
  .load__step {
    min-block-size: 1.6em;
    font-size: var(--t-lead);
    font-weight: 600;
    color: var(--c-ink-soft);
  }
  .load__track {
    inline-size: min(100%, 18rem);
    height: 3px;
    border-radius: var(--r-pill);
    background: rgb(196 181 253 / .14);
    overflow: hidden;
  }
  .load__track :global(span) {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(to left, var(--c-lav-soft), var(--c-rose));
    box-shadow: var(--glow-sm);
    transition: width .5s var(--e-soft);
  }
  /* لاتينية بحتة، فالتباعد هنا يصحّ */
  .load__pct {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: .12em;
    color: var(--c-ink-faint);
  }
  .load__done[hidden], [data-load-next][hidden] { display: none; }

  /* ==================== 7 · الاسم ==================== */
  .name__tail[hidden], [data-name-next][hidden] { display: none; }
  .name__tail {
    margin-block-start: 34svh;
    animation: rise .9s var(--e-out) backwards;
  }

  /* ==================== 8 · العدّ ==================== */
  .cd { display: grid; justify-items: center; gap: var(--s-4); }
  .cd[hidden] { display: none; }

  .cd__big {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    animation: rise .9s var(--e-out) backwards;
  }
  .cd__big[hidden] { display: none; }
  .cd__big b {
    font-size: var(--t-display);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.04em;
    color: transparent;
    background: var(--g-text);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .cd__big span { font-size: var(--t-h3); font-weight: 600; color: var(--c-ink-soft); }

  .cd__track {
    inline-size: min(100%, 16rem);
    height: 2px;
    border-radius: var(--r-pill);
    background: rgb(196 181 253 / .14);
    overflow: hidden;
  }
  .cd__track :global(span) {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(to left, var(--c-lav-soft), var(--c-rose));
    box-shadow: var(--glow-sm);
    transition: width 1s var(--e-out);
  }
  /* الساعة أرقام لاتينية، فالتباعد يصحّ عليها ويجعلها تُقرأ عدّاداً */
  .cd__clock {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: .2em;
    color: var(--c-ink-faint);
  }

  /* آخر دقيقة */
  .last { display: grid; justify-items: center; gap: var(--s-3); }
  .last[hidden] { display: none; }
  .last__say {
    min-block-size: 1.5em;
    font-size: var(--t-lead);
    font-weight: 700;
    color: var(--c-ink-soft);
  }
  .last__n {
    font-size: clamp(7rem, 4rem + 24vw, 15rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.05em;
    color: var(--c-ink);
    text-shadow: 0 0 60px rgb(196 181 253 / .45);
  }
  /* نبضة كنبضة القلب: انقباض حادّ ثم استرخاء، لا ذبذبة متساوية */
  .last__n.beat { animation: beat 1s var(--e-out); }
  @keyframes beat {
    0%   { transform: scale(1.22); opacity: .45; filter: blur(10px); }
    22%  { transform: scale(1);    opacity: 1;   filter: blur(0); }
    100% { transform: scale(1);    opacity: 1;   filter: blur(0); }
  }

  /* ==================== 10 · الكشف ==================== */
  .scene--reveal { gap: var(--s-5); }

  .reveal__name {
    font-size: var(--t-display);
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--c-ink);
    animation: spark 2.4s var(--e-out) backwards;
  }
  .reveal__name[hidden] { display: none; }
  /* تولد نقطةً ثم تتّسع: الاسم يخرج من الضوء لا من الفراغ */
  /* بلا تباعد حرفي: «رغد» كلمةٌ موصولة، وتوسيعها يفكّها بدل أن يوسّعها.
     الاتّساع يأتي من `scale` وحده. */
  @keyframes spark {
    0%   { opacity: 0; transform: scale(.15); filter: blur(26px); }
    45%  { opacity: 1; transform: scale(1);   filter: blur(0); }
    100% { opacity: 1; }
  }

  .reveal__body[hidden] { display: none; }
  .reveal__body { display: grid; justify-items: center; gap: var(--s-4); }

  .reveal__greet {
    font-size: var(--t-h1);
    font-weight: 700;
    letter-spacing: -.025em;
    color: transparent;
    background: var(--g-text);
    -webkit-background-clip: text;
    background-clip: text;
    animation: rise 1s var(--e-out) backwards;
  }
  .reveal__lines { display: grid; gap: var(--s-3); }
  .reveal__l {
    font-size: var(--t-lead);
    line-height: 1.75;
    color: var(--c-ink-soft);
    text-wrap: balance;
    animation: rise .9s var(--e-out) backwards;
    animation-delay: var(--d, 0ms);
  }
  .reveal__l:last-child { color: var(--c-ink); font-weight: 700; }
  .scene--reveal .scene__hint,
  .scene--reveal .btn {
    animation: rise .9s var(--e-out) backwards;
    animation-delay: var(--d, 0ms);
  }

  /* ==================== حركة مخفّضة ==================== */
  @media (prefers-reduced-motion: reduce) {
    .scene__in, .huge, .clue.in, .cd__big, .last__n.beat,
    .reveal__name, .reveal__greet, .reveal__l, .clues__tail, .name__tail,
    .scene--reveal .scene__hint, .scene--reveal .btn {
      animation: none !important;
    }
    .pulse, .dossier__scan { animation: none; }
    .thread__fill, .cd__track :global(span), .load__track :global(span) { transition: none; }
    .clue { opacity: 1; }
  }
</style>
