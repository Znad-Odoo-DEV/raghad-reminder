---
import {
  HUB, DEPTS, DECREES, NET, RHYME, SUPPORT, MOON, NAILS, COURT, DISHES, HUNT,
} from '../scripts/copy';
import type { DeptKey } from '../scripts/copy';

/**
 * Stage — البوّابة وأقسام الوزارة في مكان واحد.
 *
 * كلها موجودة في الـHTML و`main.ts` تُظهر واحداً فقط. هذا يجعل الانتقال
 * تلاشياً بين طبقتين لا إعادة بناء للـDOM، فيبقى ناعماً على الهاتف —
 * وأنيميشن الدخول تعمل من جديد تلقائياً لأن العنصر يخرج من `display:none`.
 *
 * لا سكربت هنا. المكوّن يشحن العلامات والأنماط، والسلوك كلّه في `main.ts`
 * عبر `data-*`. ما يُنشئه `main.ts` من عناصر (القيود، أسطر القصيدة) يُنمَّط
 * بـ`:global()` تحت جذرٍ مُصرَّف، لأن نطاق Astro لا يصل إلى ما يُبنى لاحقاً.
 */

const dept = (key: DeptKey) => DEPTS.find((d) => d.key === key)!;
const pad2 = (n: number) => String(n).padStart(2, '0');
---

<div class="stage">
  <!-- ═══════════════ البوّابة ═══════════════ -->
  <section class="scene scene--hub" data-scene="hub" hidden>
    <header class="seal scene__in" style="--d: 0ms">
      <svg class="seal__mark" viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".55" />
        <circle cx="60" cy="60" r="48" fill="none" stroke="currentColor" stroke-width=".8" stroke-dasharray="2 4" opacity=".5" />
        <!-- برجٌ للاتصالات وثلاث موجات: شعار وزارةٍ تحترم نفسها -->
        <path d="M60 86V52" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path d="M46 86h28" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path d="M60 52l-9 34M60 52l9 34" stroke="currentColor" stroke-width="1.6" opacity=".7" />
        <path d="M44 44a22 22 0 0 1 32 0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <path d="M37 35a32 32 0 0 1 46 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity=".75" />
        <path d="M51 51a12 12 0 0 1 18 0" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
      </svg>
      <p class="kicker">{HUB.republic}</p>
      <h1 class="seal__title">{HUB.ministry}</h1>
      <p class="seal__minister">{HUB.minister}</p>
      <p class="seal__slogan"><span class="grad">«{HUB.slogan}»</span></p>
    </header>

    <p class="scene__hint scene__in" style="--d: 500ms">{HUB.intro}</p>

    <nav class="depts" aria-label="أقسام الوزارة">
      {DEPTS.map((d, i) => (
        <button class="dept scene__in" style={`--d: ${650 + i * 60}ms`} type="button" data-go={d.key}>
          <span class="dept__icon" aria-hidden="true">{d.icon}</span>
          <span class="dept__title">{d.title}</span>
          <span class="dept__hint">{d.hint}</span>
        </button>
      ))}
    </nav>
  </section>

  <!-- ═══════════════ ١ · قسم المراسيم ═══════════════ -->
  <section class="scene scene--dept" data-scene="decrees" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('decrees').icon}</span> {dept('decrees').title}</p>
    </header>
    <p class="scene__lead">{DECREES.lead}</p>

    <form class="form" data-decree-form>
      <textarea class="field" data-decree-text rows="3" maxlength="280" placeholder={DECREES.placeholder} required></textarea>
      <button class="btn btn--primary" type="submit">{DECREES.cta}</button>
    </form>
    <p class="form__say" data-decree-say aria-live="polite">&nbsp;</p>

    <ol class="records" data-decree-list></ol>
    <p class="scene__hint" data-decree-empty hidden>{DECREES.empty}</p>
    <p class="kicker">{DECREES.officer}</p>
  </section>

  <!-- ═══════════════ ٢ · لوحة حالة النت ═══════════════ -->
  <section class="scene scene--dept scene--hush" data-scene="net" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('net').icon}</span> {dept('net').title}</p>
    </header>

    <div class="board">
      <p class="kicker">{NET.label}</p>
      <p class="board__status"><i class="board__dot" aria-hidden="true"></i>{NET.up}</p>
    </div>

    <button class="btn btn--primary" type="button" data-net-report>{NET.cta}</button>

    <div class="ticket" data-net-ticket hidden>
      <p class="kicker"><span>{NET.ticket}</span> <b class="tnum" data-net-n></b></p>
      <p class="ticket__reply" data-net-reply></p>
    </div>
  </section>

  <!-- ═══════════════ ٣ · مصلحة صباح النور ═══════════════ -->
  <section class="scene scene--dept" data-scene="rhyme" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('rhyme').icon}</span> {dept('rhyme').title}</p>
    </header>
    <p class="scene__lead">{RHYME.lead}</p>

    <ol class="poem" data-rhyme-list>
      {RHYME.seed.map((l) => <li class="poem__l poem__l--seed">{l}</li>)}
    </ol>

    <form class="form form--row" data-rhyme-form>
      <input class="field" data-rhyme-text type="text" maxlength="80" placeholder={RHYME.placeholder} autocomplete="off" required />
      <button class="btn btn--primary" type="submit">{RHYME.cta}</button>
    </form>
    <p class="scene__hint">{RHYME.rule}</p>
    <p class="form__say" data-rhyme-say aria-live="polite">&nbsp;</p>
  </section>

  <!-- ═══════════════ ٤ · إدارة الدعم ═══════════════ -->
  <section class="scene scene--dept scene--hush" data-scene="support" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('support').icon}</span> {dept('support').title}</p>
    </header>
    <p class="scene__lead">{SUPPORT.lead}</p>

    <button class="support" type="button" data-support>{SUPPORT.cta}</button>

    <p class="huge support__line" data-support-line hidden></p>
    <p class="scene__hint" data-support-sent hidden>{SUPPORT.sent}</p>
  </section>

  <!-- ═══════════════ ٥ · مرصد القمر ═══════════════ -->
  <section class="scene scene--dept scene--hush" data-scene="moon" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('moon').icon}</span> {dept('moon').title}</p>
    </header>

    <p class="verse">{MOON.verse[0]}<br />{MOON.verse[1]}</p>

    <svg class="moon" viewBox="0 0 192 192" role="img" aria-label="القمر الليلة">
      <defs>
        <radialGradient id="moon-lit" cx="40%" cy="38%">
          <stop offset="0%" stop-color="#fffdf5" />
          <stop offset="100%" stop-color="#e6ddff" />
        </radialGradient>
      </defs>
      <circle cx="96" cy="96" r="96" class="moon__dark" />
      <path class="moon__lit" data-moon-path d="" fill="url(#moon-lit)" />
    </svg>

    <p class="kicker">{MOON.tonight}</p>
    <p class="huge" data-moon-name>—</p>
    <p class="scene__lead"><b class="tnum" data-moon-pct>—</b>٪ {MOON.lit}</p>
    <p class="scene__hint">{MOON.note}</p>
  </section>

  <!-- ═══════════════ ٦ · هيئة المناكير ═══════════════ -->
  <section class="scene scene--dept" data-scene="nails" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('nails').icon}</span> {dept('nails').title}</p>
    </header>
    <p class="scene__lead">{NAILS.lead}</p>

    <div class="swatches">
      {NAILS.swatches.map((s) => (
        <button class="swatch" type="button" data-swatch={s.hex} style={`--sw: ${s.hex}`}>
          <i class="swatch__dot" aria-hidden="true"></i>
          <span class="swatch__name">{s.name}</span>
        </button>
      ))}
      <label class="swatch swatch--custom">
        <input type="color" data-swatch-custom value="#c4b5fd" aria-label={NAILS.custom} />
        <i class="swatch__dot swatch__dot--wheel" aria-hidden="true"></i>
        <span class="swatch__name">{NAILS.custom}</span>
      </label>
    </div>

    <button class="btn btn--quiet" type="button" data-swatch-reset>{NAILS.reset}</button>
    <p class="form__say" data-nails-say aria-live="polite">&nbsp;</p>
  </section>

  <!-- ═══════════════ ٧ · المحكمة العليا للمجاملات ═══════════════ -->
  <section class="scene scene--dept" data-scene="court" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('court').icon}</span> {dept('court').title}</p>
    </header>
    <p class="scene__lead">{COURT.lead}</p>

    <form class="form form--row" data-court-form>
      <input class="field" data-court-text type="text" maxlength="140" placeholder={COURT.placeholder} autocomplete="off" />
      <button class="btn btn--primary" type="submit">{COURT.cta}</button>
    </form>

    <div class="verdict" data-court-verdict hidden>
      <p class="kicker">{COURT.verdictLabel}</p>
      <p class="verdict__text" data-court-out></p>
    </div>

    <p class="kicker">{COURT.recordTitle}</p>
    <ol class="records" data-court-list></ol>
    <p class="scene__hint" data-court-empty hidden>{COURT.empty}</p>
  </section>

  <!-- ═══════════════ ٨ · دائرة الجلي ═══════════════ -->
  <section class="scene scene--dept scene--hush" data-scene="dishes" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('dishes').icon}</span> {dept('dishes').title}</p>
    </header>
    <p class="scene__lead">{DISHES.lead}</p>

    <p class="timer tnum" data-dishes-time>{pad2(DISHES.minutes)}:00</p>
    <div class="track" aria-hidden="true"><span data-dishes-fill></span></div>
    <p class="form__say" data-dishes-say aria-live="polite">&nbsp;</p>

    <div class="row">
      <button class="btn btn--primary" type="button" data-dishes-toggle>{DISHES.start}</button>
      <button class="btn btn--quiet" type="button" data-dishes-reset>{DISHES.reset}</button>
    </div>

    <div class="done" data-dishes-done hidden>
      <p class="huge">{DISHES.done}</p>
      <p class="scene__lead">{DISHES.doneSub}</p>
    </div>
  </section>

  <!-- ═══════════════ ٩ · صيد الملوخية ═══════════════ -->
  <section class="scene scene--dept" data-scene="hunt" hidden>
    <header class="dept-head">
      <button class="back" type="button" data-go="hub">{HUB.back}</button>
      <p class="dept-head__title"><span aria-hidden="true">{dept('hunt').icon}</span> {dept('hunt').title}</p>
    </header>
    <p class="scene__lead">{HUNT.lead}</p>

    <p class="hud">
      <span class="kicker">{HUNT.scoreLabel}</span> <b class="tnum" data-hunt-score>0</b>
      <span class="hud__sep">·</span>
      <b class="tnum" data-hunt-time>{HUNT.seconds}</b>
    </p>

    <canvas class="hunt" data-hunt-canvas aria-label="ورق ملوخية ينزل"></canvas>

    <button class="btn btn--primary" type="button" data-hunt-start>{HUNT.start}</button>
    <p class="huge" data-hunt-result hidden></p>
  </section>
</div>

<style>
  /* ==================== المسرح ==================== */
  .stage {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: start center;
    padding: clamp(2.5rem, 2rem + 3vw, 4rem) var(--pad-x) clamp(7rem, 6rem + 3vw, 9rem);
  }

  .scene {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    inline-size: min(100%, 34rem);
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }
  .scene[hidden] { display: none; }
  .scene--hush { gap: var(--s-5); }

  .scene__in {
    animation: rise .8s var(--e-out) backwards;
    animation-delay: var(--d, 0ms);
  }
  /* البوّابة تتدرّج مرّةً واحدة. بعدها كل رجوعٍ إليها فوريّ: الرجوع
     انتقالٌ لا دخولٌ أوّل، وإعادة التدرّج تجعله انتظاراً. */
  .scene--hub.is-warm .scene__in { animation: none; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); filter: blur(5px); }
    to   { opacity: 1; transform: none; filter: none; }
  }

  /* ==================== نصوص مشتركة ==================== */
  .kicker {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--c-ink-faint);
  }
  .huge {
    font-size: var(--t-h2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -.02em;
    color: var(--c-ink);
    text-wrap: balance;
    animation: rise .8s var(--e-out) backwards;
  }
  .huge[hidden] { display: none; }
  .scene__lead {
    font-size: var(--t-lead);
    line-height: 1.7;
    color: var(--c-ink-soft);
    text-wrap: balance;
  }
  .scene__hint { font-size: var(--t-xs); color: var(--c-ink-faint); }
  .scene__hint[hidden] { display: none; }

  .grad {
    color: transparent;
    background: var(--g-text);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .grad::selection { -webkit-text-fill-color: #fff; color: #fff; background: rgb(109 74 202 / .6); }

  /* ==================== البوّابة ==================== */
  .seal { display: grid; justify-items: center; gap: .3rem; }
  .seal__mark {
    inline-size: 5.2rem;
    color: var(--c-lav-soft);
    filter: drop-shadow(0 0 22px color-mix(in srgb, var(--tint) 45%, transparent));
    margin-block-end: .5rem;
  }
  .seal__title {
    font-size: var(--t-h1);
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--c-ink);
  }
  .seal__minister { font-size: var(--t-body); color: var(--c-ink-soft); font-weight: 600; }
  .seal__slogan { font-size: var(--t-sm); font-weight: 700; margin-block-start: .2rem; }

  .depts {
    inline-size: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .6rem;
    margin-block-start: var(--s-3);
  }
  .dept {
    display: grid;
    justify-items: center;
    gap: .28rem;
    padding: .95rem .5rem .8rem;
    border-radius: var(--r-md);
    background: var(--c-glass);
    border: 1px solid var(--c-hairline);
    color: var(--c-ink);
    text-align: center;
    transition: transform var(--d-fast) var(--e-back), background var(--d-base) var(--e-soft),
                border-color var(--d-base) var(--e-soft), box-shadow var(--d-base) var(--e-soft);
    -webkit-tap-highlight-color: transparent;
  }
  .dept:hover, .dept:focus-visible {
    transform: translateY(-3px);
    background: var(--c-glass-hi);
    border-color: color-mix(in srgb, var(--tint) 55%, transparent);
    box-shadow: var(--glow-sm);
    outline: none;
  }
  .dept:active { transform: translateY(0) scale(.97); }
  .dept__icon { font-size: 1.55rem; line-height: 1; }
  .dept__title { font-size: var(--t-xs); font-weight: 700; line-height: 1.35; }
  .dept__hint { font-size: .7rem; color: var(--c-ink-faint); line-height: 1.35; }

  @media (max-width: 400px) {
    .depts { grid-template-columns: repeat(2, 1fr); }
    /* تسعة على عمودين: الأخير وحده — فيأخذ الصفّ كلّه بدل أن يبقى يتيماً */
    .dept:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }

  /* ==================== رأس القسم ==================== */
  .dept-head {
    inline-size: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block-end: var(--s-3);
    border-block-end: 1px solid var(--c-hairline);
  }
  .dept-head__title { font-size: var(--t-sm); font-weight: 700; color: var(--c-ink); }
  .back {
    padding: .45rem .8rem;
    border-radius: var(--r-pill);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--c-ink-soft);
    background: var(--c-glass);
    border: 1px solid var(--c-hairline);
    transition: background var(--d-fast) var(--e-soft), color var(--d-fast) var(--e-soft);
  }
  .back:hover { background: var(--c-glass-hi); color: var(--c-ink); }

  /* ==================== النماذج ==================== */
  .form { inline-size: 100%; display: grid; gap: .6rem; }
  .form--row { grid-template-columns: 1fr auto; align-items: stretch; }
  .field {
    inline-size: 100%;
    padding: .8rem 1rem;
    border-radius: var(--r-sm);
    background: var(--c-glass);
    border: 1px solid var(--c-hairline);
    color: var(--c-ink);
    font: inherit;
    font-size: var(--t-body);
    line-height: 1.6;
    resize: vertical;
    transition: border-color var(--d-fast) var(--e-soft), box-shadow var(--d-fast) var(--e-soft);
  }
  .field::placeholder { color: var(--c-ink-faint); }
  .field:focus { outline: none; border-color: var(--c-lav-soft); box-shadow: var(--glow-sm); }
  .form__say {
    min-block-size: 1.5em;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--c-lav-soft);
  }
  .row { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: center; }

  /* ==================== القيود (تُبنى بالـJS) ==================== */
  .records { inline-size: 100%; display: grid; gap: .6rem; list-style: none; padding: 0; }
  .records :global(.record) {
    position: relative;
    padding: .9rem 1rem .8rem;
    border-radius: var(--r-md);
    background: var(--c-glass);
    border: 1px solid var(--c-hairline);
    text-align: start;
    animation: rise .6s var(--e-out) backwards;
  }
  .records :global(.record__n) {
    display: block;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--c-lav-soft);
  }
  .records :global(.record__t) {
    margin-block: .25rem .4rem;
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--c-ink);
    word-break: break-word;
  }
  /* الختم: مائل قليلاً، كختمٍ حقيقي لا يقع مستقيماً أبداً */
  .records :global(.record__stamp) {
    display: inline-block;
    padding: .15rem .55rem;
    border: 1.5px solid color-mix(in srgb, var(--tint) 70%, transparent);
    border-radius: 4px;
    font-size: .68rem;
    font-weight: 700;
    color: var(--c-lav-soft);
    transform: rotate(-2.5deg);
  }
  .records :global(.record__when) {
    float: inline-end;
    font-size: .7rem;
    color: var(--c-ink-faint);
  }

  /* ==================== حالة النت ==================== */
  .board {
    inline-size: 100%;
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--c-glass);
    border: 1px solid var(--c-hairline);
    display: grid;
    gap: .3rem;
  }
  .board__status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    font-size: var(--t-h3);
    font-weight: 700;
    color: var(--c-ink);
  }
  .board__dot {
    inline-size: .7rem; block-size: .7rem;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 14px #4ade80;
    animation: blink 2.4s var(--e-soft) infinite;
  }
  @keyframes blink { 50% { opacity: .45; } }

  .ticket {
    inline-size: 100%;
    padding: var(--s-4);
    border-radius: var(--r-md);
    border: 1.5px dashed color-mix(in srgb, var(--tint) 55%, transparent);
    display: grid;
    gap: .4rem;
    animation: rise .6s var(--e-out) backwards;
  }
  .ticket[hidden] { display: none; }
  .ticket__reply { font-size: var(--t-lead); line-height: 1.65; color: var(--c-ink); font-weight: 600; }

  /* ==================== القصيدة ==================== */
  .poem {
    inline-size: 100%;
    list-style: none;
    padding: var(--s-4) var(--s-5);
    margin: 0;
    display: grid;
    gap: .35rem;
    border-radius: var(--r-md);
    background: var(--c-glass);
    border: 1px solid var(--c-hairline);
    font-size: var(--t-lead);
    line-height: 1.7;
    color: var(--c-ink);
  }
  .poem__l--seed { color: var(--c-ink-soft); }
  .poem :global(.poem__l) { animation: rise .6s var(--e-out) backwards; }
