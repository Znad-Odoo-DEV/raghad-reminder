---
import { GRACE } from '../scripts/copy';
import { COINCIDENCE_AT, FIRST_TALK_AT, dateAr } from '../scripts/schedule';
import HeartGlyph from './HeartGlyph.astro';

/**
 * البطاقة الرئيسية — عدّاد الصدفة.
 *
 * الأيام هي البطل: رقم واحد كبير، وتحته ساعة:دقيقة:ثانية بحجم أصغر. أربعة
 * أرقام متساوية الحجم كانت تخنق شاشة الموبايل ولا يبقى فيها شيء «بطل».
 *
 * التاريخ يُقرأ وقت البناء من site.config.ts. إن لم يُضبط، تُعرض البطاقة بلا
 * أرقام — عدّاد بتاريخ مخترع أسوأ من لا عدّاد.
 */
const coincidenceDate = dateAr(COINCIDENCE_AT);
const firstTalkDate = dateAr(FIRST_TALK_AT);
const hasCounter = COINCIDENCE_AT !== null;
---

<section class="grace" id="grace" aria-labelledby="grace-heading">
  <div class="wrap">
    <h2 id="grace-heading" class="sr-only">رغد طابت — الحمد لله</h2>

    <article class="card" data-card>
      <span class="card__aura" aria-hidden="true"></span>

      <!-- ================= الرأس ================= -->
      <header class="card__head">
        <button
          class="heart"
          type="button"
          data-heart
          aria-label="قلب — للزينة، وللنقر إذا حبيتِ"
        >
          <HeartGlyph id="card-heart" />
        </button>

        <div class="card__id">
          <p class="card__eyebrow">{GRACE.eyebrow}</p>
          <p class="card__date">{coincidenceDate ?? '—'}</p>
          <p class="card__tz">بتوقيت سوريا</p>
        </div>

        <span class="chip">{GRACE.chip}</span>
      </header>

      <!-- ================= اللوحة ================= -->
      <div class="card__panel">
        {
          hasCounter ? (
            <>
              <p class="card__label">{GRACE.label}</p>

              <div
                class="since"
                data-since
                role="timer"
                aria-live="off"
                aria-label="الوقت الذي مرّ من يوم الصدفة"
              >
                <span class="since__days">
                  <b class="since__n tnum" data-unit="d">—</b>
                  <span class="since__k" data-unit-k="d">يوم</span>
                </span>

                <span class="since__clock tnum" aria-hidden="true">
                  <span data-unit="h">00</span><span class="since__sep">:</span
                  ><span data-unit="m">00</span><span class="since__sep">:</span
                  ><span data-unit="s">00</span>
                </span>
              </div>
            </>
          ) : (
            <p class="card__label card__label--alone">{GRACE.noDate}</p>
          )
        }

        <p class="card__title">{GRACE.title}</p>
        <p class="card__note">{GRACE.note}</p>

        {
          firstTalkDate && (
            <p class="second">
              <span class="second__k">ومن يوم ما بلّشنا نحكي</span>
              <b class="second__v tnum" data-talk>—</b>
              <span class="second__d">{firstTalkDate}</span>
            </p>
          )
        }
      </div>

      <!-- ================= الزر ================= -->
      <footer class="card__actions">
        <button class="btn btn--primary" type="button" data-act="thanks">
          الحمد لله 🤍
        </button>
        <p class="actions__hint" data-thanks-hint>اضغطي، وأنا كمان رح قولها معك.</p>
      </footer>
    </article>

    <!-- همسة اللطافة المتغيّرة تحت البطاقة -->
    <p class="whisper" data-whisper aria-live="polite"></p>
  </div>
</section>

<style>
  .grace {
    position: relative;
    padding-block-end: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  /* ================= البطاقة ================= */
  .card {
    position: relative;
    max-width: 720px;
    margin-inline: auto;
    padding: clamp(1.35rem, .9rem + 2.2vw, 2.6rem);
    border-radius: clamp(var(--r-lg), 4vw, var(--r-xl));
    background: rgba(255, 255, 255, .78);
    border: 1px solid rgba(255, 255, 255, .9);
    box-shadow: var(--sh-lg);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    overflow: hidden;
    animation: card-in 1s var(--e-out) .18s backwards;
    transition: box-shadow var(--d-slow) var(--e-soft);
  }

  @keyframes card-in {
    from { opacity: 0; transform: translateY(26px) scale(.97); }
    to   { opacity: 1; transform: none; }
  }

  /* هالة ملوّنة أعلى البطاقة */
  .card__aura {
    position: absolute;
    inset-block-start: -55%;
    inset-inline-start: 50%;
    translate: 50% 0;
    width: 130%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c-accent) 22%, transparent), transparent 62%);
    pointer-events: none;
    transition: background var(--d-slow) var(--e-soft);
  }

  /* نبضة ترحيب بعد وصول القلب */
  .card.is-armed { box-shadow: var(--sh-lg), 0 0 0 6px color-mix(in srgb, var(--c-accent) 14%, transparent); }

  /* ================= الرأس ================= */
  .card__head {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(.75rem, .4rem + 1.4vw, 1.15rem);
    padding-block-end: var(--s-5);
    border-block-end: 1px solid rgba(23, 18, 56, .08);
  }

  .heart {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: clamp(56px, 13vw, 74px);
    height: clamp(56px, 13vw, 74px);
    border-radius: var(--r-md);
    background: linear-gradient(160deg, #fff, var(--c-pink-wash));
    border: 1px solid rgba(255, 77, 141, .16);
    padding: clamp(11px, 2.4vw, 15px);
    box-shadow: var(--sh-sm);
    transition: transform var(--d-fast) var(--e-back), box-shadow var(--d-base) var(--e-soft);
    /* القلب يطير للداخل عند فتح الصفحة */
    animation: heart-arrive 1.15s var(--e-back) backwards;
  }
  .heart:hover  { transform: translateY(-3px) rotate(-6deg); box-shadow: var(--sh-md); }
  .heart:active { transform: scale(.93) rotate(4deg); }
  .heart.is-beating { animation: heart-beat .62s var(--e-soft); }

  @keyframes heart-arrive {
    0%   { opacity: 0; transform: translate(-42vw, -46vh) scale(2.6) rotate(-150deg); }
    62%  { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  @keyframes heart-beat {
    0%, 100% { transform: scale(1); }
    22%      { transform: scale(1.16); }
    44%      { transform: scale(.97); }
    66%      { transform: scale(1.09); }
  }

  .card__id { flex: 1; min-width: 0; }

  .card__eyebrow {
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--c-ink-faint);
    letter-spacing: .03em;
  }

  .card__date {
    font-size: clamp(1.25rem, .95rem + 1.5vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -.03em;
    line-height: 1.25;
    color: var(--c-ink);
  }

  .card__tz {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    margin-block-start: .15rem;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--c-accent-deep);
  }
  .card__tz::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: .55;
  }

  .chip {
    flex-shrink: 0;
    align-self: flex-start;
    padding: .34rem .75rem;
    border-radius: var(--r-pill);
    background: var(--c-accent-wash);
    color: var(--c-accent-deep);
    font-size: var(--t-xs);
    font-weight: 700;
    white-space: nowrap;
  }

  /* ================= اللوحة ================= */
  .card__panel {
    padding-block-start: var(--s-6);
    text-align: center;
  }

  .card__label {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--c-ink-faint);
    letter-spacing: .02em;
  }
  .card__label--alone {
    max-width: 40ch;
    margin-inline: auto;
    margin-block-end: var(--s-5);
  }

  /* ---- العدّاد: الأيام هي البطل ---- */
  .since {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .35rem;
    margin-block: var(--s-3) var(--s-5);
  }

  .since__days {
    display: flex;
    align-items: baseline;
    gap: .55rem;
  }

  .since__n {
    font-size: clamp(4rem, 2rem + 13vw, 8.5rem);
    font-weight: 700;
    line-height: .92;
    letter-spacing: -.055em;
    color: var(--c-ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .since__n.is-tick { animation: tick .5s var(--e-out); }

  @keyframes tick {
    0%   { transform: translateY(-18%); opacity: .25; }
    60%  { transform: translateY(2%);   opacity: 1; }
    100% { transform: none; }
  }

  .since__k {
    font-size: clamp(1rem, .85rem + .7vw, 1.5rem);
    font-weight: 700;
    color: var(--c-accent-deep);
    letter-spacing: -.01em;
  }

  .since__clock {
    display: inline-flex;
    align-items: baseline;
    font-size: clamp(1.15rem, .9rem + 1.4vw, 1.85rem);
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--c-ink-faint);
  }
  .since__sep {
    padding-inline: .12em;
    color: color-mix(in srgb, var(--c-accent) 60%, transparent);
    font-weight: 300;
  }

  .card__title {
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: -.02em;
    margin-block-end: .4rem;
  }

  .card__note {
    max-width: 44ch;
    margin-inline: auto;
    color: var(--c-ink-soft);
    font-size: var(--t-body);
  }

  /* ---- العدّاد الثاني ---- */
  .second {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: .45rem;
    margin-block-start: var(--s-5);
    padding: .5rem 1.15rem;
    border-radius: var(--r-pill);
    background: var(--c-surface-soft);
    border: 1px solid rgba(23, 18, 56, .08);
    box-shadow: var(--sh-sm);
    font-size: var(--t-sm);
  }
  .second__k { color: var(--c-ink-faint); }
  .second__v {
    font-size: 1.2em;
    font-weight: 700;
    color: var(--c-accent-deep);
  }
  .second__d {
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
    opacity: .8;
  }

  /* ================= الزر ================= */
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .7rem;
    margin-block-start: var(--s-6);
  }

  .actions__hint {
    flex-basis: 100%;
    text-align: center;
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }

  /* ================= همسة اللطافة ================= */
  .whisper {
    min-height: 2.8em;
    max-width: 46ch;
    margin: var(--s-5) auto 0;
    text-align: center;
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--c-ink-faint);
    transition: opacity var(--d-base) var(--e-soft);
  }
  .whisper.is-swapping { opacity: 0; }

  /* ================= الموبايل ================= */
  @media (max-width: 480px) {
    .card__head { flex-wrap: wrap; }
    .chip { order: -1; margin-inline-start: auto; }
    .btn { flex: 1 1 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .heart { animation: none; }
    .btn--primary::after { animation: none; opacity: 0; }
  }
</style>
