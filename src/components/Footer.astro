---
import { ANALYTICS } from '../analytics.config';
import { FROM, HER } from '../site.config';
import { VOW } from '../scripts/copy';

const year = new Date().getFullYear();

// label=%20 يجعل الشارة أرقاماً فقط، فنضع نصّنا العربي بجانبها.
const hitsSrc = ANALYTICS.hitsKey
  ? `https://hits.sh/${ANALYTICS.hitsKey}.svg?view=today-total&label=%20&color=ff4d8d&labelColor=171238&style=flat-square`
  : null;
const hitsPage = ANALYTICS.hitsKey ? `https://hits.sh/${ANALYTICS.hitsKey}/` : null;
---

<footer class="foot">
  <div class="wrap foot__inner">
    <p class="foot__line reveal">
      صُنع خصيصاً لـ{HER}، لأنها
      <span class="foot__em">ألطف وأجمل صدفة</span> صارت بحياتي 🤍
    </p>

    <p class="foot__sign reveal" style="--reveal-delay: 60ms">
      من {FROM} — وفي شي جاي 🎁
    </p>

    <p class="foot__vow reveal" style="--reveal-delay: 90ms">{VOW}</p>

    <p class="foot__brand reveal" style="--reveal-delay: 110ms">
      <button class="foot__heart" type="button" data-foot-egg aria-label="قلب صغير">🤍</button>
      <span>Made for {HER} · super special edition</span>
    </p>

    {
      hitsSrc && (
        <a
          class="visits reveal"
          style="--reveal-delay: 150ms"
          href={hitsPage}
          target="_blank"
          rel="noopener noreferrer"
          title="اليوم / الإجمالي"
        >
          <span class="visits__eye" aria-hidden="true">👀</span>
          <span class="visits__label">زيارات</span>
          <img class="visits__badge" src={hitsSrc} alt="عدد الزيارات: اليوم ثم الإجمالي" width="58" height="20" />
        </a>
      )
    }

    <p class="foot__meta reveal" style="--reveal-delay: 190ms">
      <span class="tnum">{year}</span>
      <span aria-hidden="true">·</span>
      <span>بلا حساب وبلا كوكيز. منسجّل وقت الفتح وبس.</span>
    </p>
  </div>
</footer>

<style>
  .foot {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) clamp(2rem, 1.4rem + 2vw, 3rem);
    border-block-start: 1px solid rgba(23, 18, 56, .08);
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, .5));
  }

  .foot__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .foot__line {
    max-width: 34ch;
    font-size: var(--t-lead);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.6;
    color: var(--c-ink);
  }
  .foot__em {
    background: linear-gradient(transparent 62%, var(--c-lav-wash) 62%);
    padding-inline: .1em;
  }

  .foot__sign {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--c-accent-deep);
  }

  /* الوعد — سطر هادئ بإطار خفيف، يُقرأ كعهد لا كشعار */
  .foot__vow {
    max-width: 40ch;
    padding: var(--s-3) var(--s-5);
    border-radius: var(--r-md);
    border: 1px dashed rgba(167, 139, 250, .38);
    background: rgba(255, 255, 255, .5);
    font-size: var(--t-sm);
    line-height: 1.85;
    color: var(--c-ink-soft);
  }

  .foot__brand {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: .5rem 1.1rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, .7);
    border: 1px solid rgba(23, 18, 56, .07);
    box-shadow: var(--sh-sm);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--c-ink-soft);
    direction: ltr;
  }

  .foot__heart {
    font-size: 1.05rem;
    line-height: 1;
    transition: transform var(--d-fast) var(--e-back);
  }
  .foot__heart:hover  { transform: scale(1.25) rotate(-8deg); }
  .foot__heart:active { transform: scale(.85); }

  /* ---- عدّاد الزيارات ---- */
  .visits {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .35rem .75rem .35rem .35rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, .7);
    border: 1px solid rgba(23, 18, 56, .07);
    box-shadow: var(--sh-sm);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--c-ink-soft);
    text-decoration: none;
    transition: transform var(--d-fast) var(--e-back), box-shadow var(--d-base) var(--e-soft);
  }
  .visits:hover { transform: translateY(-2px); box-shadow: var(--sh-md); }

  .visits__eye { font-size: .9rem; line-height: 1; }

  .visits__badge {
    height: 20px;
    width: auto;
    border-radius: 4px;
    /* الشارة نفسها LTR */
    direction: ltr;
  }

  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }
</style>
