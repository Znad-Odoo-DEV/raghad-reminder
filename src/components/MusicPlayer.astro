---
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { SONG } from '../site.config';

/**
 * MusicPlayer — «عيني اليمين» لحمد العامري
 *
 * ثلاثة أوضاع، يُختار الوضع وقت البناء:
 *
 *  1. ملف محلي — إن وُجد `public/music/track.(mp3|m4a|ogg|wav)` نستخدم عنصر
 *     <audio>. هذا هو الوضع الفعلي هنا: صوت خلفية حقيقي، بلا مشغّل مرئي،
 *     ويبدأ لوحده عند أول تفاعل.
 *
 *  2. يوتيوب — إن لم يوجد ملف وكان `SONG.videoId` مضبوطاً، نضمّن المشغّل
 *     الرسمي. لا نستضيف أي تسجيل تجاري في المستودع.
 *
 *  3. لا شيء — إن لم يوجد ملف ولا معرّف فيديو، لا نرسم زراً معطّلاً.
 */

const AUDIO_DIR = path.join(process.cwd(), 'public', 'music');
const EXTS = ['mp3', 'm4a', 'ogg', 'wav'];

const found = fs.existsSync(AUDIO_DIR)
  ? EXTS.map((e) => `track.${e}`).find((f) => fs.existsSync(path.join(AUDIO_DIR, f)))
  : undefined;

/**
 * بصمة محتوى في الرابط.
 *
 * اسم الملف ثابت (`track.m4a`) فتبديل الأغنية لا يغيّر الرابط، ويبقى المتصفّح
 * وعامل الخدمة يخدمان النسخة القديمة إلى أن تنتهي صلاحيتها. البصمة تجعل كل
 * أغنية رابطاً جديداً، فالتبديل يصل فوراً.
 */
const stamp = found
  ? createHash('sha1').update(fs.readFileSync(path.join(AUDIO_DIR, found))).digest('hex').slice(0, 8)
  : '';

const localSrc = found ? `${import.meta.env.BASE_URL}music/${found}?v=${stamp}` : null;
const mode = localSrc ? 'local' : SONG.videoId ? 'youtube' : 'none';
---

{
  mode !== 'none' && (
    <div class="music" data-music data-mode={mode}>
      {localSrc && (
        <audio data-music-audio src={localSrc} loop preload="auto" playsinline></audio>
      )}

      {/* ===== الزر ===== */}
      <button class="music__pill" type="button" data-music-toggle aria-pressed="false">
        <span class="music__eq" data-music-eq aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </span>
        <span class="music__note" data-music-note aria-hidden="true">🎵</span>
        <span class="music__label" data-music-label>شغّلي الأغنية</span>
      </button>

      {/* ===== بطاقة يوتيوب (وضع الاحتياط فقط) ===== */}
      {mode === 'youtube' && (
        <div class="music__card" data-music-card hidden>
          <div class="music__head">
            <div class="music__meta">
              <p class="music__track">{SONG.track}</p>
              <p class="music__artist">{SONG.artist}</p>
            </div>
            <button
              class="music__close"
              type="button"
              data-music-close
              aria-label="إيقاف الأغنية"
            >
              ✕
            </button>
          </div>
          <div class="music__frame" data-music-frame data-video={SONG.videoId} />
          <p class="music__credit">من القناة الرسمية 🤍</p>
        </div>
      )}
    </div>
  )
}

<style>
  .music {
    position: fixed;
    inset-block-end: clamp(.75rem, .4rem + 1vw, 1.25rem);
    /* في RTL هذا هو الجانب الأيسر من الشاشة */
    inset-inline-end: clamp(.75rem, .4rem + 1vw, 1.25rem);
    z-index: 80;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .5rem;
  }

  /* ---- الزر ---- */
  .music__pill {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .6rem 1rem;
    border-radius: var(--r-pill);
    background: var(--c-glass);
    border: 1px solid var(--c-hairline);
    border: 1px solid rgba(23, 18, 56, .1);
    box-shadow: var(--sh-md);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--c-ink);
    transition: transform var(--d-fast) var(--e-back), box-shadow var(--d-base) var(--e-soft);
  }
  .music__pill:hover { transform: translateY(-2px); box-shadow: var(--sh-lg); }
  .music__pill:active { transform: translateY(0) scale(.96); }

  .music__label {
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* النوتة تظهر وهي متوقفة، والمكافئ يظهر وهي شغالة */
  .music__note {
    font-size: 1rem;
    line-height: 1;
    animation: bob 2.6s var(--e-soft) infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(0); }
    50%      { transform: translateY(-3px) rotate(-9deg); }
  }

  .music__eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 15px;
    flex-shrink: 0;
  }
  .music__eq span {
    width: 3px;
    border-radius: 2px;
    background: var(--g-brand);
    animation: eq .9s var(--e-soft) infinite alternate;
  }
  .music__eq span:nth-child(1) { height: 40%; animation-delay: 0s; }
  .music__eq span:nth-child(2) { height: 95%; animation-delay: .18s; }
  .music__eq span:nth-child(3) { height: 60%; animation-delay: .36s; }
  .music__eq span:nth-child(4) { height: 80%; animation-delay: .54s; }

  @keyframes eq {
    from { transform: scaleY(.3); }
    to   { transform: scaleY(1); }
  }

  .music.is-playing .music__note { display: none; }
  .music.is-playing .music__eq { display: flex; }
  .music.is-playing .music__pill {
    background: linear-gradient(135deg, rgba(167, 139, 250, .18), rgba(109, 74, 255, .14)), var(--c-glass);
    border-color: rgba(167, 139, 250, .3);
  }

  /* حالة "بانتظار أول لمسة" — نبضة خفيفة تلمّح أن في شي جاهز */
  .music.is-waiting .music__pill {
    animation: waiting 2.4s var(--e-soft) infinite;
  }
  @keyframes waiting {
    0%, 100% { box-shadow: var(--sh-md); }
    50%      { box-shadow: var(--sh-md), 0 0 0 6px rgba(167, 139, 250, .14); }
  }

  /* ---- بطاقة يوتيوب ---- */
  .music__card {
    width: min(78vw, 236px);
    padding: .7rem;
    border-radius: var(--r-md);
    background: var(--c-glass-hi);
    border: 1px solid rgba(23, 18, 56, .1);
    box-shadow: var(--sh-lg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: music-in .4s var(--e-back);
  }
  @keyframes music-in {
    from { opacity: 0; transform: translateY(12px) scale(.94); }
    to   { opacity: 1; transform: none; }
  }

  .music__head {
    display: flex;
    align-items: center;
    gap: .55rem;
    margin-block-end: .55rem;
  }
  .music__meta { flex: 1; min-width: 0; }
  .music__track {
    font-size: var(--t-xs);
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .music__artist { font-size: .68rem; color: var(--c-ink-faint); }

  .music__close {
    width: 26px; height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    font-size: .8rem;
    color: var(--c-ink-faint);
    background: var(--c-glass);
    transition: background var(--d-fast) var(--e-soft);
  }
  .music__close:hover { background: var(--c-glass-hi); color: var(--c-ink); }

  .music__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-xs);
    overflow: hidden;
    background: #000;
  }
  .music__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .music__credit {
    margin-block-start: .45rem;
    font-size: .66rem;
    color: var(--c-ink-faint);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .music__note, .music__eq span, .music__card, .music.is-waiting .music__pill {
      animation: none;
    }
  }

  @media (max-width: 360px) {
    .music__label { display: none; }
    .music__pill { padding: .6rem .7rem; }
  }
</style>
