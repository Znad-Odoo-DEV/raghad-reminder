---
import { WISHES } from '../scripts/copy';
---

<section class="wishes-band section" aria-labelledby="wishes-heading">
  <div class="wrap">
    <div class="wishes-band__head reveal">
      <p class="eyebrow">اللي منتمناه إلك</p>
      <h2 id="wishes-heading" class="wishes-band__title">
        ثلاث أمنيات، <span class="gradient-text">وكلهن وحدة.</span>
      </h2>
    </div>

    <ul class="wishes">
      {WISHES.map((w, i) => (
        <li class="wish reveal" style={`--reveal-delay: ${i * 110}ms`}>
          <span class="wish__n tnum" aria-hidden="true">{w.n}</span>
          <h3 class="wish__title">{w.title}</h3>
          <p class="wish__body">{w.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wishes-band__head {
    max-width: 40ch;
    margin-inline: auto;
    text-align: center;
    margin-block-end: clamp(1.75rem, 1.1rem + 2.2vw, 3rem);
  }

  .wishes-band__title {
    font-size: var(--t-h2);
    letter-spacing: -.03em;
    margin-block-start: var(--s-3);
  }

  .wishes {
    display: grid;
    gap: clamp(.7rem, .5rem + .8vw, 1rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .wishes { grid-template-columns: repeat(3, 1fr); }
  }

  .wish {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: clamp(1.35rem, 1rem + 1.6vw, 2rem);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, .74);
    border: 1px solid rgba(23, 18, 56, .07);
    box-shadow: var(--sh-sm);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      transform var(--d-base) var(--e-out),
      box-shadow var(--d-base) var(--e-soft),
      border-color var(--d-base) var(--e-soft);
  }
  .wish:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c-pink) 36%, transparent);
    box-shadow: var(--sh-md);
  }

  .wish__n {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.04em;
    /* الرقم زخرفي — نتركه باهتاً حتى يبقى العنوان هو البطل */
    background: var(--g-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: .55;
  }

  .wish__title {
    font-size: clamp(1.08rem, .95rem + .7vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.4;
    text-wrap: balance;
  }

  .wish__body {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    line-height: 1.8;
  }
</style>
