---
/**
 * HeartGlyph — القلب
 *
 * منحنيان بيزيه متناظران حول محور الرمز، فيبقى القلب متوازناً تماماً في كل
 * الأحجام. حلّ محلّ كبسولة الدواء لمّا صار الموقع رسالة فرح لا تذكير بجرعة.
 */
interface Props {
  /** معرّف فريد للتدرّجات — لتفادي تضارب الـIDs عند تكرار الرمز */
  id?: string;
  class?: string;
}

const { id = 'heart', class: className } = Astro.props;
---

<svg
  class:list={['heart-glyph', className]}
  viewBox="0 0 64 58"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-a`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ff8ec7" />
      <stop offset="55%" stop-color="#ff4d8d" />
      <stop offset="100%" stop-color="#6d4aff" />
    </linearGradient>
    <radialGradient id={`${id}-shine`} cx="32%" cy="26%" r="42%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity=".85" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>

  <path
    d="M32 53C32 53 4 36.5 4 20.5 4 11.4 11.2 4 20.2 4 25.6 4 30.2 6.9 32 11.2 33.8 6.9 38.4 4 43.8 4 52.8 4 60 11.4 60 20.5 60 36.5 32 53 32 53Z"
    fill={`url(#${id}-a)`}
  />
  <path
    d="M32 53C32 53 4 36.5 4 20.5 4 11.4 11.2 4 20.2 4 25.6 4 30.2 6.9 32 11.2 33.8 6.9 38.4 4 43.8 4 52.8 4 60 11.4 60 20.5 60 36.5 32 53 32 53Z"
    fill="none"
    stroke="rgba(23,18,56,.1)"
    stroke-width="1.4"
  />
  <ellipse cx="20" cy="17" rx="8.5" ry="5.5" fill={`url(#${id}-shine)`} transform="rotate(-24 20 17)" />
</svg>

<style>
  .heart-glyph {
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
