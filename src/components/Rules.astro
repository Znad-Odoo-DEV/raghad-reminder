---
const rules = [
  { n: '01', title: 'الدوا ما بينتظر مزاج' },
  { n: '02', title: 'كلمة «شوي» غير معتمدة' },
  { n: '03', title: 'التجاهل لا يُلغي الدوا' },
];
---

<section class="rules-band section" aria-labelledby="rules-heading">
  <div class="wrap">
    <div class="rules-band__head reveal">
      <p class="eyebrow">بنود لا نقاش فيها</p>
      <h2 id="rules-heading" class="rules-band__title">
        ثلاث قواعد، <span class="gradient-text">وبس.</span>
      </h2>
    </div>

    <ul class="rules">
      {rules.map((r, i) => (
        <li class="rule reveal" style={`--reveal-delay: ${i * 110}ms`}>
          <span class="rule__n tnum" aria-hidden="true">{r.n}</span>
          <h3 class="rule__title">{r.title}</h3>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rules-band__head {
    max-width: 40ch;
    margin-inline: auto;
    text-align: center;
    margin-block-end: clamp(1.75rem, 1.1rem + 2.2vw, 3rem);
  }

  .rules-band__title {
    font-size: var(--t-h2);
    letter-spacing: -.03em;
    margin-block-start: var(--s-3);
  }

  .rules {
    display: grid;
    gap: clamp(.7rem, .5rem + .8vw, 1rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .rules { grid-template-columns: repeat(3, 1fr); }
  }

  .rule {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: clamp(1.35rem, 1rem + 1.6vw, 2rem);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, .74);
    border: 1px solid rgba(23, 18, 56, .07);
    box-shadow: var(--sh-sm);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      transform var(--d-base) var(--e-out),
      box-shadow var(--d-base) var(--e-soft),
      border-color var(--d-base) var(--e-soft);
  }
  .rule:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c-accent) 32%, transparent);
    box-shadow: var(--sh-md);
  }

  .rule__n {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.04em;
    /* الرقم زخرفي — نتركه باهتاً حتى يبقى العنوان هو البطل */
    background: var(--g-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: .55;
  }

  .rule__title {
    font-size: clamp(1.08rem, .95rem + .7vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.4;
    text-wrap: balance;
  }
</style>
